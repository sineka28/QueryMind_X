# QueryMind Environment Variables
#
# These are pre-populated by the Bolt environment. Copy to .env if running locally.

# Supabase
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend (Edge Function secrets — configured in Supabase dashboard, not in client .env)
# SUPABASE_URL=your-supabase-url
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# OPENAI_API_KEY=your-openai-api-key  (optional — without it, the built-in heuristic SQL engine is used)
